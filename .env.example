# Copy this file to .env.local and fill in only the systems you use.
# .env.local is gitignored. Never paste these values into a chat or a commit.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

DASHBOARD_TITLE="My Company KPIs"

# Password for the dashboard's login page. Visitors stay signed in for 30 days; changing it signs everyone out.
# Leave empty to run without a login, e.g. on localhost. Set it on Vercel before sharing the URL.
DASHBOARD_PASSWORD=

# HubSpot: Settings -> Integrations -> Private Apps -> Create app
# Scopes needed: crm.objects.contacts.read, crm.objects.deals.read
HUBSPOT_TOKEN=

# Stripe: Developers -> API keys -> Create restricted key (read-only)
STRIPE_SECRET_KEY=

# Zendesk: Admin Center -> Apps and integrations -> APIs -> Zendesk API -> Add API token
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_TOKEN=

# Freshdesk: Profile avatar -> Profile settings -> API key
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# QuickBooks Online: developer.intuit.com -> your app -> OAuth 2.0 playground
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
# Use "sandbox" while testing, "production" for real company data
QBO_ENV=production
